# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/aeccentric-ems

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=aeccentric_super_secret_jwt_key_change_in_prod
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=aeccentric_refresh_secret_change_in_prod
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Email (Nodemailer / Gmail) ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── Frontend URL (CORS) ──────────────────────────────
CLIENT_URL=http://localhost:5173
